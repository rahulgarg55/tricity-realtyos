# ==============================================================================
# TRICITY REALTYOS — ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and configure secrets according to your environment.
# ==============================================================================

# Database Connection (SQLite locally, PostgreSQL in Production e.g. Neon, Supabase, Render)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/realtyos?sslmode=require"

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="generate-a-secure-32-byte-hex-or-base64-secret-key"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3050"
PORT=3050

# WhatsApp Business Cloud API (Official Meta Graph API)
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_API_URL="https://graph.facebook.com"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_APP_SECRET=""

# SaaS Billing (Stripe / Razorpay for INR payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Node Environment
NODE_ENV="development"
