datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                      String   @id @default(uuid())
  name                    String
  slug                    String   @unique
  logoUrl                 String?
  phone                   String?
  address                 String?
  city                    String   @default("Mohali")
  state                   String   @default("Punjab")
  country                 String   @default("India")
  timezone                String   @default("Asia/Kolkata")
  currency                String   @default("INR")
  
  subscriptionTier        String   @default("STARTER")
  subscriptionStatus      String   @default("ACTIVE")
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  subscriptionRenewsAt    DateTime?
  maxUsers                Int      @default(5)
  maxLeads                Int      @default(500)
  maxProjects             Int      @default(3)
  
  whatsappEnabled         Boolean  @default(false)
  whatsappPhoneNumberId   String?
  whatsappBusinessAccountId String?
  whatsappAccessToken     String?
  whatsappWebhookSecret   String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                   User[]
  leads                   Lead[]
  projects                Project[]
  inventoryUnits          InventoryUnit[]
  siteVisits              SiteVisit[]
  tasks                   TaskFollowUp[]
  activities              LeadActivity[]
  whatsAppMessages        WhatsAppMessage[]
  invoices                SubscriptionInvoice[]
  auditLogs               AuditLog[]

  @@index([slug])
  @@index([subscriptionStatus])
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  name            String
  phone           String?
  passwordHash    String
  role            String        @default("SALES_REP")
  isSuperAdmin    Boolean       @default(false)
  isActive        Boolean       @default(true)
  avatarUrl       String?
  
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedLeads   Lead[]        @relation("AssignedLeads")
  assignedVisits  SiteVisit[]   @relation("AssignedVisits")
  assignedTasks   TaskFollowUp[] @relation("AssignedTasks")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Project {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  developer       String
  location        String
  city            String        @default("Mohali")
  projectType     String        @default("Residential")
  description     String?
  amenities       String?
  brochureUrl     String?
  startingPrice   Float?
  status          String        @default("UNDER_CONSTRUCTION")
  reraNumber      String?

  units           InventoryUnit[]
  leads           Lead[]
  siteVisits      SiteVisit[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
  @@index([city])
}

model InventoryUnit {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitNumber      String
  tower           String?
  floor           Int?
  unitType        String        @default("3BHK")
  carpetAreaSqFt  Float
  superAreaSqFt   Float?
  askingPrice     Float
  status          String        @default("AVAILABLE")
  
  heldUntil       DateTime?
  heldByUserId    String?
  bookingAmount   Float?
  
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedUserId  String?
  notes           String?

  siteVisits      SiteVisit[]
  statusHistory   InventoryStatusHistory[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId])
  @@index([projectId, status])
  @@index([heldUntil])
}

model InventoryStatusHistory {
  id              String        @id @default(uuid())
  unitId          String
  unit            InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedByUserId String
  reason          String?
  timestamp       DateTime      @default(now())

  @@index([unitId])
}

model Lead {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  phone             String
  email             String?
  preferredLocation String?
  budgetMin         Float?
  budgetMax         Float?
  propertyType      String?
  
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  leadSource        String        @default("Website")
  priority          String        @default("MEDIUM")
  stage             String        @default("NEW_LEAD")
  
  assignedUserId    String?
  assignedUser      User?         @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)

  lastContactedAt   DateTime?
  nextFollowUpDate  DateTime?
  lostReason        String?
  lostNotes         String?
  expectedRevenue   Float?
  notes             String?
  isArchived        Boolean       @default(false)

  siteVisits        SiteVisit[]
  tasks             TaskFollowUp[]
  activities        LeadActivity[]
  inventoryUnits    InventoryUnit[]
  whatsAppMessages  WhatsAppMessage[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, stage])
  @@index([organizationId, phone])
  @@index([assignedUserId])
  @@index([nextFollowUpDate])
}

model SiteVisit {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inventoryUnitId String?
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id], onDelete: SetNull)

  assignedUserId  String
  assignedUser    User          @relation("AssignedVisits", fields: [assignedUserId], references: [id], onDelete: Cascade)

  scheduledDate   DateTime
  timeSlot        String        @default("11:00 AM - 12:00 PM")
  status          String        @default("SCHEDULED")
  location        String?
  clientFeedback  String?
  outcome         String?
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, scheduledDate])
  @@index([assignedUserId])
}

model TaskFollowUp {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedUserId  String
  assignedUser    User          @relation("AssignedTasks", fields: [assignedUserId], references: [id], onDelete: Cascade)

  title           String
  type            String        @default("CALL")
  priority        String        @default("MEDIUM")
  dueDate         DateTime
  completedAt     DateTime?
  isCompleted     Boolean       @default(false)
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, dueDate, isCompleted])
  @@index([assignedUserId])
}

model LeadActivity {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId          String?
  activityType    String
  title           String
  description     String?
  metadata        String?

  createdAt       DateTime      @default(now())

  @@index([organizationId, leadId])
}

model WhatsAppMessage {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  direction         String        @default("OUTBOUND")
  fromNumber        String
  toNumber          String
  messageBody       String
  templateName      String?
  status            String        @default("SENT")
  whatsappMessageId String?
  errorMessage      String?
  isMock            Boolean       @default(false)

  createdAt         DateTime      @default(now())

  @@index([organizationId, toNumber])
  @@index([whatsappMessageId])
}

model SubscriptionInvoice {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  amount          Float
  currency        String        @default("INR")
  status          String        @default("PAID")
  plan            String        @default("STARTER")
  invoiceNumber   String
  stripeInvoiceId String?
  paidAt          DateTime?

  createdAt       DateTime      @default(now())

  @@index([organizationId])
}

model AuditLog {
  id              String        @id @default(uuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId          String?
  action          String
  entityType      String
  entityId        String?
  details         String?
  ipAddress       String?

  createdAt       DateTime      @default(now())

  @@index([organizationId, createdAt])
}
